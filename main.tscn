[sub_resource type="Shader" id="Shader_weather_wetness"]
code = "shader_type canvas_item;\n\nuniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;\n\nvoid fragment() {\n\tvec4 scene = texture(screen_texture, SCREEN_UV);\n\tfloat light = max(scene.r, max(scene.g, scene.b));\n\tvec3 wet = mix(scene.rgb, scene.rgb * vec3(0.78, 0.86, 0.92), 0.68);\n\twet += vec3(0.045, 0.065, 0.075) * smoothstep(0.52, 0.92, light);\n\tCOLOR = vec4(wet, scene.a);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_weather_wetness"]
shader = SubResource("Shader_weather_wetness")

